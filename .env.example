# PharmaShield GCC — frontend environment
# Copy to .env.local for local development. In Vercel, set these under
# Project Settings → Environment Variables.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle and are visible to
# every visitor. Never put secrets or private API keys here.

# "true" (default) serves demonstration data with no backend required.
# "false" calls the Python backend at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Base URL of the Python backend, no trailing slash. Used only when mock mode is off.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where live shortage records come from when mock mode is off:
#   backend (default) — GET {API_BASE_URL}/shortages
#   openfda           — fetched directly from api.fda.gov via the adapter
NEXT_PUBLIC_SHORTAGE_SOURCE=backend
